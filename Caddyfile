{
    # auto_https off
    admin off
    persist_config off
}

:{$PORT} {
    
    # ----Frontend convention.wbcboxing.com-----
    @front1 host {$FRONT1_DOMAIN}
    handle @front1 {
        reverse_proxy {$FRONT1_HOST}
    }

    # --- Frontend george-foreman.wbcboxing.com ---
    @front2 host {$FRONT2_DOMAIN}
    handle @front2 {
        reverse_proxy {$FRONT2_HOST}
    }

    # --- Frontend registration.wbcboxing.com ---
    @front3 host {$FRONT3_DOMAIN}
    handle @front3 {
        reverse_proxy {$FRONT3_HOST}
    }

    # --- Frontend summit.wbcboxing.com ---
    @front4 host {$FRONT4_DOMAIN}
    handle @front4 {
        reverse_proxy {$FRONT4_HOST}
    }

    # --- BACKEND api.wbcboxing.com ---
    @back host {$BACK_DOMAIN}
    handle @back {
        reverse_proxy {$BACK_HOST}
    }

    # --- Default ---
    handle {
        respond "Proxy Configurado con Variables. Revisa tus settings en Railway." 200
    }
}
