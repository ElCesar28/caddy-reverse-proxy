{
    # Railway maneja el certificado SSL antes de llegar aquí, 
    # así que apagamos el de Caddy para evitar conflictos.
    auto_https off
    admin off
    persist_config off
}

:{$PORT} {
    
    # 1. FRONTEND: Convention
    @convention host convention.wbcboxing.com
    handle @convention {
        reverse_proxy wbc-convention-front.railway.internal:8080
    }

    # 2. FRONTEND: Blog (George Foreman)
    @blog host george-foreman.wbcboxing.com
    handle @blog {
        reverse_proxy wbc-memorandum-blog.railway.internal:8080
    }

    # 3. FRONTEND: Registration
    @registration host registration.wbcboxing.com
    handle @registration {
        reverse_proxy WBC-registration-front.railway.internal:8080
    }

    # 4. FRONTEND: Summit
    @summit host summit.wbcboxing.com
    handle @summit {
        reverse_proxy summit-front.railway.internal:8080
    }

    # 5. BACKEND API
    # Ajusta este dominio al que uses para tu API (ej: api.wbcboxing.com o registration.api...)
    @api host api.wbcboxing.com
    handle @api {
        reverse_proxy WBC-registration-back.railway.internal:8080
    }

    # Health Check / Default
    handle {
        respond "Caddy Proxy en Railway funcionando correctamente. Revisa tu dominio." 200
    }
}
